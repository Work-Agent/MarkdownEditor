{
  "name": "@workstudio-plugins/markdown-editor",
  "version": "0.1.0",
  "private": true,
  "description": "WorkStudio Markdown editor: live preview, editing, save and assets",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./workstudio": "./dist/engine.js"
  },
  "workstudio": {
    "id": "markdown-editor",
    "label": "Markdown 编辑器",
    "icon": "book",
    "pages": {
      "content": "dist/page/index.html",
      "settings": "dist/settings/index.html"
    },
    "claims": [
      {
        "extensions": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "priority": 20
      }
    ],
    "skills": [
      "skills/markdown-editor"
    ]
  },
  "scripts": {
    "build": "vite build && vite build --config vite.engine.config.ts && workstudio-plugin .",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "pack:plugin": "node scripts/pack.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.6",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@work-studio/sdk": "0.1.0",
    "katex": "^0.19.1",
    "pele": "^1.13.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fflate": "^0.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  }
}
